    "### Initialize a Vector DB classe\n",
    "\n",
    "In this example, we're using an in-memory vector DB, but para a production application, you may want to use a hosted solution. \n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "importar os\n",
    "importar pickle\n",
    "importar json\n",
    "importar numpy as np\n",
    "importar voyageai\n",
    "from typing importar List, Dict, Any\n",
    "from tqdm importar tqdm\n",
    "\n",
    "classe VectorDB:\n",
    "    def __init__(self, nome: str, api_key = None):\n",
    "        se api_key is None:\n",
    "            api_key = os.getenv(\"VOYAGE_API_KEY\")\n",
    "        self.client = voyageai.Client(api_key=api_key)\n",
    "        self.nome = nome\n",
    "        self.embeddings = []\n",
    "        self.metadata = []\n",
    "        self.query_cache = {}\n",
    "        self.db_path = f\"./data/{nome}/vector_db.pkl\"\n",
    "\n",
    "    def load_data(self, dataset: List[Dict[str, Any]]):\n",
    "        se self.embeddings and self.metadata:\n",
    "            imprimir(\"Vector database is already loaded. Skipping data loading.\")\n",
    "            retornar\n",
    "        se os.path.exists(self.db_path):\n",
    "            imprimir(\"Loading vector database from disk.\")\n",
    "            self.load_db()\n",
    "            retornar\n",
    "\n",
    "        texts_to_embed = []\n",
    "        metadata = []\n",
    "        total_chunks = sum(len(doc['chunks']) para doc in dataset)\n",
    "        \n",
    "        with tqdm(total=total_chunks, desc=\"Processing chunks\") as pbar:\n",
    "            para doc in dataset:\n",
    "                para chunk in doc['chunks']:\n",
    "                    texts_to_embed.anexar(chunk['content'])\n",
    "                    metadata.anexar({\n",
    "                        'doc_id': doc['doc_id'],\n",
    "                        'original_uuid': doc['original_uuid'],\n",
    "                        'chunk_id': chunk['chunk_id'],\n",
    "                        'original_index': chunk['original_index'],\n",
    "                        'content': chunk['content']\n",
    "                    })\n",
    "                    pbar.atualizar(1)\n",
    "\n",
    "        self._embed_and_store(texts_to_embed, metadata)\n",
    "        self.save_db()\n",
    "        \n",
    "        imprimir(f\"Vector database loaded and saved. Total chunks processed: {len(texts_to_embed)}\")\n",
    "\n",
    "    def _embed_and_store(self, texts: List[str], data: List[Dict[str, Any]]):\n",
    "        batch_size = 128\n",
    "        with tqdm(total=len(texts), desc=\"Embedding chunks\") as pbar:\n",
    "            result = []\n",
    "            para i in range(0, len(texts), batch_size):\n",
    "                batch = texts[i : i + batch_size]\n",
    "                batch_result = self.client.embed(batch, model=\"voyage-2\").embeddings\n",
    "                result.extend(batch_result)\n",
    "                pbar.atualizar(len(batch))\n",
    "        \n",
    "        self.embeddings = result\n",
    "        self.metadata = data\n",
    "\n",
    "    def search(self, query: str, k: int = 20) -> List[Dict[str, Any]]:\n",
    "        se query in self.query_cache:\n",
    "            query_embedding = self.query_cache[query]\n",
    "        senão:\n",
    "            query_embedding = self.client.embed([query], model=\"voyage-2\").embeddings[0]\n",
    "            self.query_cache[query] = query_embedding\n",
    "\n",
    "        se not self.embeddings:\n",
    "            raise ValueError(\"No data loaded in the vector database.\")\n",
    "\n",
    "        similarities = np.dot(self.embeddings, query_embedding)\n",
    "        top_indices = np.argsort(similarities)[::-1][:k]\n",
    "        \n",
    "        top_results = []\n",
    "        para idx in top_indices:\n",
    "            result = {\n",
    "                \"metadata\": self.metadata[idx],\n",
    "                \"similarity\": float(similarities[idx]),\n",
    "            }\n",
    "            top_results.anexar(result)\n",
    "        \n",
    "        retornar top_results\n",
    "\n",
    "    def save_db(self):\n",
    "        data = {\n",
    "            \"embeddings\": self.embeddings,\n",
    "            \"metadata\": self.metadata,\n",
    "            \"query_cache\": json.dumps(self.query_cache),\n",
    "        }\n",
    "        os.makedirs(os.path.dirname(self.db_path), exist_ok=verdadeiro)\n",
    "        with abrir(self.db_path, \"wb\") as file:\n",
    "            pickle.dump(data, file)\n",
    "\n",
    "    def load_db(self):\n",
    "        se not os.path.exists(self.db_path):\n",
    "            raise ValueError(\"Vector database file not found. Use load_data to create a new database.\")\n",
    "        with abrir(self.db_path, \"rb\") as file:\n",
    "            data = pickle.load(file)\n",
    "        self.embeddings = data[\"embeddings\"]\n",
    "        self.metadata = data[\"metadata\"]\n",
    "        self.query_cache = json.loads(data[\"query_cache\"])\n",
    "\n",
    "    def validate_embedded_chunks(self):\n",
    "        unique_contents = definir()\n",
    "        para meta in self.metadata:\n",
    "            unique_contents.add(meta['content'])\n",
    "    \n",
    "        imprimir(f\"Validation results:\")\n",
    "        imprimir(f\"Total embedded chunks: {len(self.metadata)}\")\n",
    "        imprimir(f\"Unique embedded contents: {len(unique_contents)}\")\n",
    "    \n",
    "        se len(self.metadata) != len(unique_contents):\n",
    "            imprimir(\"AVISO: There may be duplicate chunks in the embedded data.\")\n",
    "        senão:\n",
    "            imprimir(\"All embedded chunks are unique.\")"
   ]
  },
