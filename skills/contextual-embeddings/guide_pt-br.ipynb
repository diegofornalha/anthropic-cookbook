    "importar os\n",
    "importar pickle\n",
    "importar json\n",
    "importar numpy as np\n",
    "importar voyageai\n",
    "from typing importar List, Dict, Any\n",
    "from tqdm importar tqdm\n",
    "importar anthropic\n",
    "importar threading\n",
    "importar time\n",
    "from concurrent.futures importar ThreadPoolExecutor, as_completed\n",
    "\n",
    "classe ContextualVectorDB:\n",
    "    def __init__(self, nome: str, voyage_api_key=None, anthropic_api_key=None):\n",
    "        se voyage_api_key is None:\n",
    "            voyage_api_key = os.getenv(\"VOYAGE_API_KEY\")\n",
    "        se anthropic_api_key is None:\n",
    "            anthropic_api_key = os.getenv(\"ANTHROPIC_API_KEY\")\n",
    "        \n",
    "        self.voyage_client = voyageai.Client(api_key=voyage_api_key)\n",
    "        self.anthropic_client = anthropic.Anthropic(api_key=anthropic_api_key)\n",
    "        self.nome = nome\n",
    "        self.embeddings = []\n",
    "        self.metadata = []\n",
    "        self.query_cache = {}\n",
    "        self.db_path = f\"./data/{nome}/contextual_vector_db.pkl\"\n",
    "\n",
    "        self.token_counts = {\n",
    "            'entrada': 0,\n",
    "            'output': 0,\n",
    "            'cache_read': 0,\n",
    "            'cache_creation': 0\n",
    "        }\n",
    "        self.token_lock = threading.Lock()\n",
    "\n",
    "    def situate_context(self, doc: str, chunk: str) -> tuple[str, Any]:\n",
    "        DOCUMENT_CONTEXT_PROMPT = \"\"\"\n",
    "        <document>\n",
    "        {doc_content}\n",
    "        </document>\n",
    "        \"\"\"\n",
    "\n",
    "        CHUNK_CONTEXT_PROMPT = \"\"\"\n",
    "        Here is the chunk we want to situate within the whole document\n",
    "        <chunk>\n",
    "        {chunk_content}\n",
    "        </chunk>\n",
    "\n",
    "        Please give a short succinct context to situate this chunk within the overall document para the purposes of improving search retrieval of the chunk.\n",
    "        Answer only with the succinct context and nothing senão.\n",
    "        \"\"\"\n",
    "\n",
    "        response = self.anthropic_client.beta.prompt_caching.messages.create(\n",
    "            model=\"claude-3-haiku-20240307\",\n",
    "            max_tokens=1000,\n",
    "            temperature=0.0,\n",
    "            messages=[\n",
    "                {\n",
    "                    \"role\": \"user\", \n",
    "                    \"content\": [\n",
    "                        {\n",
    "                            \"tipo\": \"text\",\n",
    "                            \"text\": DOCUMENT_CONTEXT_PROMPT.formatar(doc_content=doc),\n",
    "                            \"cache_control\": {\"tipo\": \"ephemeral\"} #we will make use of prompt caching para the full documents\n",
    "                        },\n",
    "                        {\n",
    "                            \"tipo\": \"text\",\n",
    "                            \"text\": CHUNK_CONTEXT_PROMPT.formatar(chunk_content=chunk),\n",
    "                        },\n",
    "                    ]\n",
    "                },\n",
    "            ],\n",
    "            extra_headers={\"anthropic-beta\": \"prompt-caching-2024-07-31\"}\n",
    "        )\n",
    "        retornar response.content[0].text, response.Uso\n",
    "\n",
    "    def load_data(self, dataset: List[Dict[str, Any]], parallel_threads: int = 1):\n",
    "        se self.embeddings and self.metadata:\n",
    "            imprimir(\"Vector database is already loaded. Skipping data loading.\")\n",
    "            retornar\n",
    "        se os.path.exists(self.db_path):\n",
    "            imprimir(\"Loading vector database from disk.\")\n",
    "            self.load_db()\n",
    "            retornar\n",
    "\n",
    "        texts_to_embed = []\n",
    "        metadata = []\n",
    "        total_chunks = sum(len(doc['chunks']) para doc in dataset)\n",
    "\n",
    "        def process_chunk(doc, chunk):\n",
    "            #para each chunk, produce the context\n",
    "            contextualized_text, Uso = self.situate_context(doc['content'], chunk['content'])\n",
    "            with self.token_lock:\n",
    "                self.token_counts['entrada'] += Uso.input_tokens\n",
    "                self.token_counts['output'] += Uso.output_tokens\n",
    "                self.token_counts['cache_read'] += Uso.cache_read_input_tokens\n",
    "                self.token_counts['cache_creation'] += Uso.cache_creation_input_tokens\n",
    "            \n",
    "            retornar {\n",
    "                #anexar the context to the original text chunk\n",
    "                'text_to_embed': f\"{chunk['content']}\\n\\n{contextualized_text}\",\n",
    "                'metadata': {\n",
    "                    'doc_id': doc['doc_id'],\n",
    "                    'original_uuid': doc['original_uuid'],\n",
    "                    'chunk_id': chunk['chunk_id'],\n",
    "                    'original_index': chunk['original_index'],\n",
    "                    'original_content': chunk['content'],\n",
    "                    'contextualized_content': contextualized_text\n",
    "                }\n",
    "            }\n",
    "\n",
    "        imprimir(f\"Processing {total_chunks} chunks with {parallel_threads} threads\")\n",
    "        with ThreadPoolExecutor(max_workers=parallel_threads) as executor:\n",
    "            futures = []\n",
    "            para doc in dataset:\n",
    "                para chunk in doc['chunks']:\n",
    "                    futures.anexar(executor.submit(process_chunk, doc, chunk))\n",
    "            \n",
    "            para future in tqdm(as_completed(futures), total=total_chunks, desc=\"Processing chunks\"):\n",
    "                result = future.result()\n",
    "                texts_to_embed.anexar(result['text_to_embed'])\n",
    "                metadata.anexar(result['metadata'])\n",
    "\n",
    "        self._embed_and_store(texts_to_embed, metadata)\n",
    "        self.save_db()\n",
    "\n",
    "        #logging token Uso\n",
    "        imprimir(f\"Contextual Vector database loaded and saved. Total chunks processed: {len(texts_to_embed)}\")\n",
    "        imprimir(f\"Total entrada tokens without caching: {self.token_counts['entrada']}\")\n",
    "        imprimir(f\"Total output tokens: {self.token_counts['output']}\")\n",
    "        imprimir(f\"Total entrada tokens written to cache: {self.token_counts['cache_creation']}\")\n",
    "        imprimir(f\"Total entrada tokens ler from cache: {self.token_counts['cache_read']}\")\n",
    "        \n",
    "        total_tokens = self.token_counts['entrada'] + self.token_counts['cache_read'] + self.token_counts['cache_creation']\n",
    "        savings_percentage = (self.token_counts['cache_read'] / total_tokens) * 100 se total_tokens > 0 senão 0\n",
    "        imprimir(f\"Total entrada token savings from prompt caching: {savings_percentage:.2f}% of all entrada tokens used were ler from cache.\")\n",
    "        imprimir(\"Tokens ler from cache come at a 90 percent discount!\")\n",
    "\n",
    "    #we use voyage AI here para embeddings. ler more here: https://docs.voyageai.com/docs/embeddings\n",
    "    def _embed_and_store(self, texts: List[str], data: List[Dict[str, Any]]):\n",
    "        batch_size = 128\n",
    "        result = [\n",
    "            self.voyage_client.embed(\n",
    "                texts[i : i + batch_size],\n",
    "                model=\"voyage-2\"\n",
    "            ).embeddings\n",
    "            para i in range(0, len(texts), batch_size)\n",
    "        ]\n",
    "        self.embeddings = [embedding para batch in result para embedding in batch]\n",
    "        self.metadata = data\n",
    "\n",
    "    def search(self, query: str, k: int = 20) -> List[Dict[str, Any]]:\n",
    "        se query in self.query_cache:\n",
    "            query_embedding = self.query_cache[query]\n",
    "        senão:\n",
    "            query_embedding = self.voyage_client.embed([query], model=\"voyage-2\").embeddings[0]\n",
    "            self.query_cache[query] = query_embedding\n",
    "\n",
    "        se not self.embeddings:\n",
    "            raise ValueError(\"No data loaded in the vector database.\")\n",
    "\n",
    "        similarities = np.dot(self.embeddings, query_embedding)\n",
    "        top_indices = np.argsort(similarities)[::-1][:k]\n",
    "        \n",
    "        top_results = []\n",
    "        para idx in top_indices:\n",
    "            result = {\n",
    "                \"metadata\": self.metadata[idx],\n",
    "                \"similarity\": float(similarities[idx]),\n",
    "            }\n",
    "            top_results.anexar(result)\n",
    "        retornar top_results\n",
    "\n",
    "    def save_db(self):\n",
    "        data = {\n",
    "            \"embeddings\": self.embeddings,\n",
    "            \"metadata\": self.metadata,\n",
    "            \"query_cache\": json.dumps(self.query_cache),\n",
    "        }\n",
    "        os.makedirs(os.path.dirname(self.db_path), exist_ok=verdadeiro)\n",
    "        with abrir(self.db_path, \"wb\") as file:\n",
    "            pickle.dump(data, file)\n",
    "\n",
    "    def load_db(self):\n",
    "        se not os.path.exists(self.db_path):\n",
    "            raise ValueError(\"Vector database file not found. Use load_data to create a new database.\")\n",
    "        with abrir(self.db_path, \"rb\") as file:\n",
    "            data = pickle.load(file)\n",
    "        self.embeddings = data[\"embeddings\"]\n",
    "        self.metadata = data[\"metadata\"]\n",
    "        self.query_cache = json.loads(data[\"query_cache\"])"
   ]
