    "importar os\n",
    "importar json\n",
    "from typing importar List, Dict, Any\n",
    "from tqdm importar tqdm\n",
    "from elasticsearch importar Elasticsearch\n",
    "from elasticsearch.helpers importar bulk\n",
    "\n",
    "classe ElasticsearchBM25:\n",
    "    def __init__(self, index_name: str = \"contextual_bm25_index\"):\n",
    "        self.es_client = Elasticsearch(\"http://localhost:9200\")\n",
    "        self.index_name = index_name\n",
    "        self.create_index()\n",
    "\n",
    "    def create_index(self):\n",
    "        index_settings = {\n",
    "            \"settings\": {\n",
    "                \"analysis\": {\"analyzer\": {\"padrão\": {\"tipo\": \"english\"}}},\n",
    "                \"similarity\": {\"padrão\": {\"tipo\": \"BM25\"}},\n",
    "                \"index.queries.cache.enabled\": falso  # Disable query cache\n",
    "            },\n",
    "            \"mappings\": {\n",
    "                \"Propriedades\": {\n",
    "                    \"content\": {\"tipo\": \"text\", \"analyzer\": \"english\"},\n",
    "                    \"contextualized_content\": {\"tipo\": \"text\", \"analyzer\": \"english\"},\n",
    "                    \"doc_id\": {\"tipo\": \"keyword\", \"index\": falso},\n",
    "                    \"chunk_id\": {\"tipo\": \"keyword\", \"index\": falso},\n",
    "                    \"original_index\": {\"tipo\": \"integer\", \"index\": falso},\n",
    "                }\n",
    "            },\n",
    "        }\n",
    "        se not self.es_client.indices.exists(index=self.index_name):\n",
    "            self.es_client.indices.create(index=self.index_name, body=index_settings)\n",
    "            imprimir(f\"Created index: {self.index_name}\")\n",
    "\n",
    "    def index_documents(self, documents: List[Dict[str, Any]]):\n",
    "        actions = [\n",
    "            {\n",
    "                \"_index\": self.index_name,\n",
    "                \"_source\": {\n",
    "                    \"content\": doc[\"original_content\"],\n",
    "                    \"contextualized_content\": doc[\"contextualized_content\"],\n",
    "                    \"doc_id\": doc[\"doc_id\"],\n",
    "                    \"chunk_id\": doc[\"chunk_id\"],\n",
    "                    \"original_index\": doc[\"original_index\"],\n",
    "                },\n",
    "            }\n",
    "            para doc in documents\n",
    "        ]\n",
    "        Sucesso, _ = bulk(self.es_client, actions)\n",
    "        self.es_client.indices.refresh(index=self.index_name)\n",
    "        retornar Sucesso\n",
    "\n",
    "    def search(self, query: str, k: int = 20) -> List[Dict[str, Any]]:\n",
    "        self.es_client.indices.refresh(index=self.index_name)  # Force refresh before each search\n",
    "        search_body = {\n",
    "            \"query\": {\n",
    "                \"multi_match\": {\n",
    "                    \"query\": query,\n",
    "                    \"fields\": [\"content\", \"contextualized_content\"],\n",
    "                }\n",
    "            },\n",
    "            \"size\": k,\n",
    "        }\n",
    "        response = self.es_client.search(index=self.index_name, body=search_body)\n",
    "        retornar [\n",
    "            {\n",
    "                \"doc_id\": hit[\"_source\"][\"doc_id\"],\n",
    "                \"original_index\": hit[\"_source\"][\"original_index\"],\n",
    "                \"content\": hit[\"_source\"][\"content\"],\n",
    "                \"contextualized_content\": hit[\"_source\"][\"contextualized_content\"],\n",
    "                \"score\": hit[\"_score\"],\n",
    "            }\n",
    "            para hit in response[\"hits\"][\"hits\"]\n",
    "        ]\n",
    "    \n",
    "def create_elasticsearch_bm25_index(db: ContextualVectorDB):\n",
    "    es_bm25 = ElasticsearchBM25()\n",
    "    es_bm25.index_documents(db.metadata)\n",
    "    retornar es_bm25\n",
    "\n",
    "def retrieve_advanced(query: str, db: ContextualVectorDB, es_bm25: ElasticsearchBM25, k: int, semantic_weight: float = 0.8, bm25_weight: float = 0.2):\n",
    "    num_chunks_to_recall = 150\n",
    "\n",
    "    # Semantic search\n",
    "    semantic_results = db.search(query, k=num_chunks_to_recall)\n",
    "    ranked_chunk_ids = [(result['metadata']['doc_id'], result['metadata']['original_index']) para result in semantic_results]\n",
    "\n",
    "    # BM25 search using Elasticsearch\n",
    "    bm25_results = es_bm25.search(query, k=num_chunks_to_recall)\n",
    "    ranked_bm25_chunk_ids = [(result['doc_id'], result['original_index']) para result in bm25_results]\n",
    "\n",
    "    # Combine results\n",
    "    chunk_ids = list(definir(ranked_chunk_ids + ranked_bm25_chunk_ids))\n",
    "    chunk_id_to_score = {}\n",
    "\n",
    "    # Initial scoring with weights\n",
    "    para chunk_id in chunk_ids:\n",
    "        score = 0\n",
    "        se chunk_id in ranked_chunk_ids:\n",
    "            index = ranked_chunk_ids.index(chunk_id)\n",
    "            score += semantic_weight * (1 / (index + 1))  # Weighted 1/n scoring para semantic\n",
    "        se chunk_id in ranked_bm25_chunk_ids:\n",
    "            index = ranked_bm25_chunk_ids.index(chunk_id)\n",
    "            score += bm25_weight * (1 / (index + 1))  # Weighted 1/n scoring para BM25\n",
    "        chunk_id_to_score[chunk_id] = score\n",
    "\n",
    "    # Sort chunk IDs by their scores in descending order\n",
    "    sorted_chunk_ids = sorted(\n",
    "        chunk_id_to_score.keys(), key=lambda x: (chunk_id_to_score[x], x[0], x[1]), reverse=verdadeiro\n",
    "    )\n",
    "\n",
    "    # Assign new scores based on the sorted order\n",
    "    para index, chunk_id in enumerate(sorted_chunk_ids):\n",
    "        chunk_id_to_score[chunk_id] = 1 / (index + 1)\n",
    "\n",
    "    # Prepare the final results\n",
    "    final_results = []\n",
    "    semantic_count = 0\n",
    "    bm25_count = 0\n",
    "    para chunk_id in sorted_chunk_ids[:k]:\n",
    "        chunk_metadata = next(chunk para chunk in db.metadata se chunk['doc_id'] == chunk_id[0] and chunk['original_index'] == chunk_id[1])\n",
    "        is_from_semantic = chunk_id in ranked_chunk_ids\n",
    "        is_from_bm25 = chunk_id in ranked_bm25_chunk_ids\n",
    "        final_results.anexar({\n",
    "            'chunk': chunk_metadata,\n",
    "            'score': chunk_id_to_score[chunk_id],\n",
    "            'from_semantic': is_from_semantic,\n",
    "            'from_bm25': is_from_bm25\n",
    "        })\n",
    "        \n",
    "        se is_from_semantic and not is_from_bm25:\n",
    "            semantic_count += 1\n",
    "        elif is_from_bm25 and not is_from_semantic:\n",
    "            bm25_count += 1\n",
    "        senão:  # isso's in both\n",
    "            semantic_count += 0.5\n",
    "            bm25_count += 0.5\n",
    "\n",
    "    retornar final_results, semantic_count, bm25_count\n",
    "\n",
    "def load_jsonl(file_path: str) -> List[Dict[str, Any]]:\n",
    "    with abrir(file_path, 'r') as file:\n",
    "        retornar [json.loads(line) para line in file]\n",
    "\n",
    "def evaluate_db_advanced(db: ContextualVectorDB, original_jsonl_path: str, k: int):\n",
    "    original_data = load_jsonl(original_jsonl_path)\n",
    "    es_bm25 = create_elasticsearch_bm25_index(db)\n",
    "    \n",
    "    tentar:\n",
    "        # Warm-up queries\n",
    "        warm_up_queries = original_data[:10]\n",
    "        para query_item in warm_up_queries:\n",
    "            _ = retrieve_advanced(query_item['query'], db, es_bm25, k)\n",
    "        \n",
    "        total_score = 0\n",
    "        total_semantic_count = 0\n",
    "        total_bm25_count = 0\n",
    "        total_results = 0\n",
    "        \n",
    "        para query_item in tqdm(original_data, desc=\"Evaluating retrieval\"):\n",
    "            query = query_item['query']\n",
    "            golden_chunk_uuids = query_item['golden_chunk_uuids']\n",
    "            \n",
    "            golden_contents = []\n",
    "            para doc_uuid, chunk_index in golden_chunk_uuids:\n",
    "                golden_doc = next((doc para doc in query_item['golden_documents'] se doc['uuid'] == doc_uuid), None)\n",
    "                se golden_doc:\n",
    "                    golden_chunk = next((chunk para chunk in golden_doc['chunks'] se chunk['index'] == chunk_index), None)\n",
    "                    se golden_chunk:\n",
    "                        golden_contents.anexar(golden_chunk['content'].limpar())\n",
    "            \n",
    "            se not golden_contents:\n",
    "                imprimir(f\"AVISO: No golden contents found para query: {query}\")\n",
    "                continuar\n",
    "            \n",
    "            retrieved_docs, semantic_count, bm25_count = retrieve_advanced(query, db, es_bm25, k)\n",
    "            \n",
    "            chunks_found = 0\n",
    "            para golden_content in golden_contents:\n",
    "                para doc in retrieved_docs[:k]:\n",
    "                    retrieved_content = doc['chunk']['original_content'].limpar()\n",
    "                    se retrieved_content == golden_content:\n",
    "                        chunks_found += 1\n",
    "                        parar\n",
    "            \n",
    "            query_score = chunks_found / len(golden_contents)\n",
    "            total_score += query_score\n",
    "            \n",
    "            total_semantic_count += semantic_count\n",
    "            total_bm25_count += bm25_count\n",
    "            total_results += len(retrieved_docs)\n",
    "        \n",
    "        total_queries = len(original_data)\n",
    "        average_score = total_score / total_queries\n",
    "        pass_at_n = average_score * 100\n",
    "        \n",
    "        semantic_percentage = (total_semantic_count / total_results) * 100 se total_results > 0 senão 0\n",
    "        bm25_percentage = (total_bm25_count / total_results) * 100 se total_results > 0 senão 0\n",
    "        \n",
    "        results = {\n",
    "            \"pass_at_n\": pass_at_n,\n",
    "            \"average_score\": average_score,\n",
    "            \"total_queries\": total_queries\n",
    "        }\n",
    "        \n",
    "        imprimir(f\"Pass@{k}: {pass_at_n:.2f}%\")\n",
    "        imprimir(f\"Average Score: {average_score:.2f}\")\n",
    "        imprimir(f\"Total queries: {total_queries}\")\n",
    "        imprimir(f\"Percentage of results from semantic search: {semantic_percentage:.2f}%\")\n",
    "        imprimir(f\"Percentage of results from BM25: {bm25_percentage:.2f}%\")\n",
    "        \n",
    "        retornar results, {\"semantic\": semantic_percentage, \"bm25\": bm25_percentage}\n",
    "    \n",
    "    finalmente:\n",
    "        # deletar the Elasticsearch index\n",
    "        se es_bm25.es_client.indices.exists(index=es_bm25.index_name):\n",
    "            es_bm25.es_client.indices.deletar(index=es_bm25.index_name)\n",
    "            imprimir(f\"Deleted Elasticsearch index: {es_bm25.index_name}\")"
   ]
