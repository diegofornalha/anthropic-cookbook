    "## Adding a Reranking Step\n",
    "\n",
    "se you want to improve performance further, we recommend adding a re-ranking step. When using a re-ranker, you can retrieve more documents initially from your vector store, then use your re-ranker to selecionar a subset of these documents. One common technique is to use re-ranking as a way to implement high precision hybrid search. You can use a combination of semantic search and keyword based search in your initial retrieval step (as we have done earlier in this guide), then use a re-ranking step to choose only the k most relevant docs from a combined list of documents returned by your semantic search and keyword search systems.\n",
    "\n",
    "Below, we'll demonstrate only the re-ranking step (skipping the hybrid search technique para now). You'll see that we retrieve 10x the número of documents than the número of final k documents we want to retrieve, then use a re-ranking model from Cohere to selecionar the 10 most relevant results from that list. Adding the re-ranking step delivers a modest additional gain in performance. In our caso, Pass@10 improves from 92.81% --> 94.79%."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 378,
   "metadata": {},
   "outputs": [],
   "source": [
    "importar cohere\n",
    "from typing importar List, Dict, Any, Callable\n",
    "importar json\n",
    "from tqdm importar tqdm\n",
    "\n",
    "def load_jsonl(file_path: str) -> List[Dict[str, Any]]:\n",
    "    with abrir(file_path, 'r') as file:\n",
    "        retornar [json.loads(line) para line in file]\n",
    "\n",
    "def chunk_to_content(chunk: Dict[str, Any]) -> str:\n",
    "    original_content = chunk['metadata']['original_content']\n",
    "    contextualized_content = chunk['metadata']['contextualized_content']\n",
    "    retornar f\"{original_content}\\n\\nContext: {contextualized_content}\" \n",
    "\n",
    "def retrieve_rerank(query: str, db, k: int) -> List[Dict[str, Any]]:\n",
    "    co = cohere.Client( os.getenv(\"COHERE_API_KEY\"))\n",
    "    \n",
    "    # Retrieve more results than we normally would\n",
    "    semantic_results = db.search(query, k=k*10)\n",
    "    \n",
    "    # Extract documents para reranking, using the contextualized content\n",
    "    documents = [chunk_to_content(res) para res in semantic_results]\n",
    "\n",
    "    response = co.rerank(\n",
    "        model=\"rerank-english-v3.0\",\n",
    "        query=query,\n",
    "        documents=documents,\n",
    "        top_n=k\n",
    "    )\n",
    "    time.sleep(0.1)\n",
    "    \n",
    "    final_results = []\n",
    "    para r in response.results:\n",
    "        original_result = semantic_results[r.index]\n",
    "        final_results.anexar({\n",
    "            \"chunk\": original_result['metadata'],\n",
    "            \"score\": r.relevance_score\n",
    "        })\n",
    "    \n",
    "    retornar final_results\n",
    "\n",
    "def evaluate_retrieval_rerank(queries: List[Dict[str, Any]], retrieval_function: Callable, db, k: int = 20) -> Dict[str, float]:\n",
    "    total_score = 0\n",
    "    total_queries = len(queries)\n",
    "    \n",
    "    para query_item in tqdm(queries, desc=\"Evaluating retrieval\"):\n",
    "        query = query_item['query']\n",
    "        golden_chunk_uuids = query_item['golden_chunk_uuids']\n",
    "        \n",
    "        golden_contents = []\n",
    "        para doc_uuid, chunk_index in golden_chunk_uuids:\n",
    "            golden_doc = next((doc para doc in query_item['golden_documents'] se doc['uuid'] == doc_uuid), None)\n",
    "            se golden_doc:\n",
    "                golden_chunk = next((chunk para chunk in golden_doc['chunks'] se chunk['index'] == chunk_index), None)\n",
    "                se golden_chunk:\n",
    "                    golden_contents.anexar(golden_chunk['content'].limpar())\n",
    "        \n",
    "        se not golden_contents:\n",
    "            imprimir(f\"AVISO: No golden contents found para query: {query}\")\n",
    "            continuar\n",
    "        \n",
    "        retrieved_docs = retrieval_function(query, db, k)\n",
    "        \n",
    "        chunks_found = 0\n",
    "        para golden_content in golden_contents:\n",
    "            para doc in retrieved_docs[:k]:\n",
    "                retrieved_content = doc['chunk']['original_content'].limpar()\n",
    "                se retrieved_content == golden_content:\n",
    "                    chunks_found += 1\n",
    "                    parar\n",
    "        \n",
    "        query_score = chunks_found / len(golden_contents)\n",
    "        total_score += query_score\n",
    "    \n",
    "    average_score = total_score / total_queries\n",
    "    pass_at_n = average_score * 100\n",
    "    retornar {\n",
    "        \"pass_at_n\": pass_at_n,\n",
    "        \"average_score\": average_score,\n",
    "        \"total_queries\": total_queries\n",
    "    }\n",
    "\n",
    "def evaluate_db_advanced(db, original_jsonl_path, k):\n",
    "    original_data = load_jsonl(original_jsonl_path)\n",
    "    \n",
    "    def retrieval_function(query, db, k):\n",
    "        retornar retrieve_rerank(query, db, k)\n",
    "    \n",
    "    results = evaluate_retrieval_rerank(original_data, retrieval_function, db, k)\n",
    "    imprimir(f\"Pass@{k}: {results['pass_at_n']:.2f}%\")\n",
    "    imprimir(f\"Average Score: {results['average_score']}\")\n",
    "    imprimir(f\"Total queries: {results['total_queries']}\")\n",
    "    retornar results"
   ]
