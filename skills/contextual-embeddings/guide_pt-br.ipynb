    "imprimir(f\"Output tokens: {response.Uso.output_tokens}\")\n",
    "imprimir(f\"Cache creation entrada tokens: {response.Uso.cache_creation_input_tokens}\")\n",
    "imprimir(f\"Cache ler entrada tokens: {response.Uso.cache_read_input_tokens}\")"
   ]
