    "## Basic RAG\n",
    "\n",
    "To obter started, we'll definir up a basic RAG pipeline using a bare bones approach. This is sometimes called 'Naive RAG' by many in the industry. A basic RAG pipeline includes the following 3 steps:\n",
    "\n",
    "1) Chunk documents by heading - containing only the content from each subheading\n",
    "\n",
    "2) Embed each document\n",
    "\n",
    "3) Use Cosine similarity to retrieve documents in order to answer query"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 228,
   "metadata": {},
   "outputs": [],
   "source": [
    "importar json\n",
    "from typing importar List, Dict, Any, Callable, Union\n",
    "from tqdm importar tqdm\n",
    "\n",
    "def load_jsonl(file_path: str) -> List[Dict[str, Any]]:\n",
    "    \"\"\"Load JSONL file and retornar a list of dictionaries.\"\"\"\n",
    "    with abrir(file_path, 'r') as file:\n",
    "        retornar [json.loads(line) para line in file]\n",
    "\n",
    "def evaluate_retrieval(queries: List[Dict[str, Any]], retrieval_function: Callable, db, k: int = 20) -> Dict[str, float]:\n",
    "    total_score = 0\n",
    "    total_queries = len(queries)\n",
    "    \n",
    "    para query_item in tqdm(queries, desc=\"Evaluating retrieval\"):\n",
    "        query = query_item['query']\n",
    "        golden_chunk_uuids = query_item['golden_chunk_uuids']\n",
    "        \n",
    "        # Find all golden chunk contents\n",
    "        golden_contents = []\n",
    "        para doc_uuid, chunk_index in golden_chunk_uuids:\n",
    "            golden_doc = next((doc para doc in query_item['golden_documents'] se doc['uuid'] == doc_uuid), None)\n",
    "            se not golden_doc:\n",
    "                imprimir(f\"AVISO: Golden document not found para UUID {doc_uuid}\")\n",
    "                continuar\n",
    "            \n",
    "            golden_chunk = next((chunk para chunk in golden_doc['chunks'] se chunk['index'] == chunk_index), None)\n",
    "            se not golden_chunk:\n",
    "                imprimir(f\"AVISO: Golden chunk not found para index {chunk_index} in document {doc_uuid}\")\n",
    "                continuar\n",
    "            \n",
    "            golden_contents.anexar(golden_chunk['content'].limpar())\n",
    "        \n",
    "        se not golden_contents:\n",
    "            imprimir(f\"AVISO: No golden contents found para query: {query}\")\n",
    "            continuar\n",
    "        \n",
    "        retrieved_docs = retrieval_function(query, db, k=k)\n",
    "        \n",
    "        # Count how many golden chunks are in the top k retrieved documents\n",
    "        chunks_found = 0\n",
    "        para golden_content in golden_contents:\n",
    "            para doc in retrieved_docs[:k]:\n",
    "                retrieved_content = doc['metadata'].obter('original_content', doc['metadata'].obter('content', '')).limpar()\n",
    "                se retrieved_content == golden_content:\n",
    "                    chunks_found += 1\n",
    "                    parar\n",
    "        \n",
    "        query_score = chunks_found / len(golden_contents)\n",
    "        total_score += query_score\n",
    "    \n",
    "    average_score = total_score / total_queries\n",
    "    pass_at_n = average_score * 100\n",
    "    retornar {\n",
    "        \"pass_at_n\": pass_at_n,\n",
    "        \"average_score\": average_score,\n",
    "        \"total_queries\": total_queries\n",
    "    }\n",
    "\n",
    "def retrieve_base(query: str, db, k: int = 20) -> List[Dict[str, Any]]:\n",
    "    \"\"\"\n",
    "    Retrieve relevant documents using either VectorDB or ContextualVectorDB.\n",
    "    \n",
    "    :param query: The query texto\n",
    "    :param db: The VectorDB or ContextualVectorDB instance\n",
    "    :param k: número of top results to retrieve\n",
    "    :retornar: List of retrieved documents\n",
    "    \"\"\"\n",
    "    retornar db.search(query, k=k)\n",
    "\n",
    "def evaluate_db(db, original_jsonl_path: str, k):\n",
    "    # Load the original JSONL data para queries and ground truth\n",
    "    original_data = load_jsonl(original_jsonl_path)\n",
    "    \n",
    "    # Evaluate retrieval\n",
    "    results = evaluate_retrieval(original_data, retrieve_base, db, k)\n",
    "    imprimir(f\"Pass@{k}: {results['pass_at_n']:.2f}%\")\n",
    "    imprimir(f\"Total Score: {results['average_score']}\")\n",
    "    imprimir(f\"Total queries: {results['total_queries']}\")"
   ]
  },
