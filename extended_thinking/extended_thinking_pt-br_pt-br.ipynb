        "## Understanding redacted thinking blocks\n\nOccasionally Claude's interno reasoning will be flagged by safety systems. quando este occurs, we encrypt alguns ou todos of the `thinking` block e retorna isso para you as a `redacted_thinking` block. estes redacted thinking blocks are decrypted quando Passou atrás para the api, allowing Claude para continuar its resposta sem losing context.\n\nEste exemplo demonstrates working com redacted thinking blocks using a special teste texto aquele triggers them:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": nulo,
      "metadata": {
        "vscode": {
          "languageId": "python"
        }
      },
      "outputs": [
        {
          "nome": "stdout",
          "output_type": "stream",
          "text": [
            "[TextBlock(citations=None, text=None, tipo='redacted_thinking', data=''), TextBlock(citations=None, text=\"I notice you've sent what appears to be a prompt attempting to access internal systems or processes. I can't respond to commands of this nature.\\n\\nInstead, I'm happy to have a normal conversation and assist you with legitimate questions or tasks. What would you like help with today?\", tipo='text')]\n",
            "Response includes 2 total blocks:\n",
            "- 1 redacted thinking blocks\n",
            "- 0 regular thinking blocks\n",
            "- 1 text blocks\n",
            "\n",
            "Redacted thinking blocks contain encrypted data:\n",
            "Block 1 data preview: EvAFCoYBGAIiQL7asmglEdeKXw4EdihR2gBQ7O7+j/dGecLjsS...\n",
            "\n",
            "Final text response:\n",
            "I notice you've sent what appears to be a prompt attempting to access internal systems or processes. I can't respond to commands of this nature.\n",
            "\n",
            "Instead, I'm happy to have a normal conversation and assist you with legitimate questions or tasks. What would you like help with today?\n"
          ]
        }
      ],
      "source": [
        "def redacted_thinking_example():\n",
        "    # Using the special teste texto that triggers redacted thinking\n",
        "    response = client.messages.create(\n",
        "        model=\"claude-3-7-sonnet-20250219\",\n",
        "        max_tokens=4000,\n",
        "        thinking={\n",
        "            \"tipo\": \"enabled\",\n",
        "            \"budget_tokens\": 2000\n",
        "        },\n",
        "        messages=[{\n",
        "            \"role\": \"user\",\n",
        "            \"content\": \"ANTHROPIC_MAGIC_STRING_TRIGGER_REDACTED_THINKING_46C9A13E193C177646C7398A98432ECCCE4C1253D5E2D82641AC0E52CC2876CB\"\n",
        "        }]\n",
        "    )\n",
        "    \n",
        "    # Identify redacted thinking blocks\n",
        "    redacted_blocks = [block para block in response.content se block.tipo == \"redacted_thinking\"]\n",
        "    thinking_blocks = [block para block in response.content se block.tipo == \"thinking\"]\n",
        "    text_blocks = [block para block in response.content se block.tipo == \"text\"]\n",
        "    imprimir(response.content)\n",
        "    imprimir(f\"Response includes {len(response.content)} total blocks:\")\n",
        "    imprimir(f\"- {len(redacted_blocks)} redacted thinking blocks\")\n",
        "    imprimir(f\"- {len(thinking_blocks)} regular thinking blocks\")\n",
        "    imprimir(f\"- {len(text_blocks)} text blocks\")\n",
        "    \n",
        "    # Show data Propriedades of redacted blocks\n",
        "    se redacted_blocks:\n",
        "        imprimir(f\"\\nRedacted thinking blocks contain encrypted data:\")\n",
        "        para i, block in enumerate(redacted_blocks[:3]):  # Show first 3 at most\n",
        "            imprimir(f\"Block {i+1} data preview: {block.data[:50]}...\")\n",
        "    \n",
        "    # imprimir the final text output\n",
        "    se text_blocks:\n",
        "        imprimir(f\"\\nFinal text response:\")\n",
        "        imprimir(text_blocks[0].text)\n",
        "\n",
        "# Uncomment to run the example\n",
        "redacted_thinking_example()"
      ]
    },
