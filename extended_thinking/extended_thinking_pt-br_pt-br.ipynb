        "def demonstrate_common_errors():\n",
        "    # 1. Erro from setting thinking budget too small\n",
        "    tentar:\n",
        "        response = client.messages.create(\n",
        "            model=\"claude-3-7-sonnet-20250219\",\n",
        "            max_tokens=4000,\n",
        "            thinking={\n",
        "                \"tipo\": \"enabled\",\n",
        "                \"budget_tokens\": 500  # Too small, minimum is 1024\n",
        "            },\n",
        "            messages=[{\n",
        "                \"role\": \"user\",\n",
        "                \"content\": \"Explain quantum computing.\"\n",
        "            }]\n",
        "        )\n",
        "    except Exception as e:\n",
        "        imprimir(f\"\\nError with too small thinking budget: {e}\")\n",
        "    \n",
        "    # 2. Erro from using temperature with thinking\n",
        "    tentar:\n",
        "        response = client.messages.create(\n",
        "            model=\"claude-3-7-sonnet-20250219\",\n",
        "            max_tokens=4000,\n",
        "            temperature=0.7,  # Not compatible with thinking\n",
        "            thinking={\n",
        "                \"tipo\": \"enabled\",\n",
        "                \"budget_tokens\": 2000\n",
        "            },\n",
        "            messages=[{\n",
        "                \"role\": \"user\",\n",
        "                \"content\": \"escrever a creative story.\"\n",
        "            }]\n",
        "        )\n",
        "    except Exception as e:\n",
        "        imprimir(f\"\\nError with temperature and thinking: {e}\")\n",
        "    \n",
        "    # 3. Erro from exceeding context window\n",
        "    tentar:\n",
        "        # Create a very large prompt\n",
        "        long_content = \"Please analyze this text. \" + \"This is sample text. \" * 150000\n",
        "        \n",
        "        response = client.messages.create(\n",
        "            model=\"claude-3-7-sonnet-20250219\",\n",
        "            max_tokens=20000,  # This plus the long prompt will exceed context window\n",
        "            thinking={\n",
        "                \"tipo\": \"enabled\",\n",
        "                \"budget_tokens\": 10000\n",
        "            },\n",
        "            messages=[{\n",
        "                \"role\": \"user\",\n",
        "                \"content\": long_content\n",
        "            }]\n",
        "        )\n",
        "    except Exception as e:\n",
        "        imprimir(f\"\\nError from exceeding context window: {e}\")\n",
