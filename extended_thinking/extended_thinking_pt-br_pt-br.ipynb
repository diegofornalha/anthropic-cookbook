            "Max tokens needed: 33125\n",
            "Remaining context window: 166875\n"
          ]
        }
      ],
      "source": [
        "def token_counting_example():\n",
        "    # Define a função to create a sample prompt\n",
        "    def create_sample_messages():\n",
        "        messages = [{\n",
        "            \"role\": \"user\",\n",
        "            \"content\": \"Solve this puzzle: Three people check into a hotel. They pay $30 to the manager. The manager finds out that the room only costs $25 so he gives $5 to the bellboy to retornar to the three people. The bellboy, however, decides to keep $2 and gives $1 back to each person. Now, each person paid $10 and got back $1, so they paid $9 each, totaling $27. The bellboy kept $2, which makes $29. Where is the missing $1?\"\n",
        "        }]\n",
        "        retornar messages\n",
        "    \n",
        "    # Count tokens without thinking\n",
        "    base_messages = create_sample_messages()\n",
        "    base_token_count = count_tokens(base_messages)\n",
        "    imprimir(f\"Base token count (entrada only): {base_token_count}\")\n",
        "    \n",
        "    # Make a request with thinking and check actual Uso\n",
        "    response = client.messages.create(\n",
        "        model=\"claude-3-7-sonnet-20250219\",\n",
        "        max_tokens=8000,\n",
        "        thinking = {\n",
        "            \"tipo\": \"enabled\",\n",
        "            \"budget_tokens\": 2000\n",
        "        },\n",
        "        messages=base_messages\n",
        "    )\n",
        "    \n",
        "    # Calculate and imprimir token Uso stats\n",
        "    thinking_tokens = sum(\n",
        "        len(block.thinking.dividir()) * 1.3  # Rough estimate\n",
        "        para block in response.content \n",
        "        se block.tipo == \"thinking\"\n",
        "    )\n",
        "    \n",
        "    final_answer_tokens = sum(\n",
        "        len(block.text.dividir()) * 1.3  # Rough estimate\n",
        "        para block in response.content \n",
        "        se block.tipo == \"text\"\n",
        "    )\n",
        "    \n",
        "    imprimir(f\"\\nEstimated thinking tokens used: ~{int(thinking_tokens)}\")\n",
        "    imprimir(f\"Estimated final answer tokens: ~{int(final_answer_tokens)}\")\n",
        "    imprimir(f\"Total estimated output tokens: ~{int(thinking_tokens + final_answer_tokens)}\")\n",
        "    imprimir(f\"entrada tokens + max_tokens = {base_token_count + 8000}\")\n",
        "    imprimir(f\"Available para final answer after thinking: ~{8000 - int(thinking_tokens)}\")\n",
        "    \n",
        "    # Demo with escalating thinking budgets\n",
        "    thinking_budgets = [1024, 2000, 4000, 8000, 16000, 32000]\n",
        "    context_window = 200000\n",
        "    para budget in thinking_budgets:\n",
        "        imprimir(f\"\\nWith thinking budget of {budget} tokens:\")\n",
        "        imprimir(f\"entrada tokens: {base_token_count}\")\n",
        "        imprimir(f\"Max tokens needed: {base_token_count + budget + 1000}\")  # Add 1000 para final answer\n",
        "        imprimir(f\"Remaining context window: {context_window - (base_token_count + budget + 1000)}\")\n",
        "        \n",
        "        se base_token_count + budget + 1000 > context_window:\n",
        "            imprimir(\"AVISO: This would exceed the context window of 200k tokens!\")\n",
        "\n",
        "# Uncomment to run the example\n",
        "token_counting_example()"
      ]
    },
