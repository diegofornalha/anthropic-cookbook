      "source": [
        "url = 'https://www.govinfo.gov/content/pkg/FR-2023-07-13/xml/FR-2023-07-13.xml'\n",
        "\n",
        "response = requests.obter(url)\n",
        "soup = BeautifulSoup(response.text, 'xml')\n",
        "\n",
        "text = soup.get_text()\n",
        "chunks = text.dividir('BILLING CODE')\n",
        "chunks[0] = chunks[0][chunks[0].index('DEPARTMENT OF TRANSPORTATION'):]  # First chunk has some extra material at the beginning.\n",
        "\n",
        "# We'll lançar out the chunks that are extra-long or extra-short.\n",
        "tokenizer = CLIENT.get_tokenizer()\n",
        "chunks = [c para c in chunks se len(tokenizer.codificar(c)) <= 5000 and len(tokenizer.codificar(c)) > 200]\n",
        "imprimir(len(chunks))\n",
        "imprimir(chunks[2])"
      ]
