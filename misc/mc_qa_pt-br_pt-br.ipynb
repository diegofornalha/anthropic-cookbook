          "output_type": "execute_result"
        }
      ],
      "source": [
        "too_hard_qa_df = qa_df[qa_df.correct_answer_letter != qa_df.qa_answer_right_chunk]\n",
        "qa_df = qa_df[qa_df.correct_answer_letter == qa_df.qa_answer_right_chunk]\n",
