        "from bs4 importar BeautifulSoup\n",
        "API_KEY = os.environ['ANTHROPIC_API_KEY']\n",
        "CLIENT = anthropic.Anthropic(api_key=API_KEY)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {},
      "outputs": [
        {
          "nome": "stdout",
          "output_type": "stream",
          "text": [
