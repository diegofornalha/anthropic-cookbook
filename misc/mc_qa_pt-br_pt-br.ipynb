    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The results do não show much improvement se any. Can we do better by adding \"poucos-shot\" Exemplos aquele are mais germane para the tarefa? \n\nThe procedure para generating estes few_shot Exemplos is as follows. para each question, encontrar its associated chunk, então choose random QAs de other chunks aquele aren't aquele chunk.\n\nWe will experiment com using 2 e 5 Exemplos, com e sem a scratchpad."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 54,
      "metadata": {},
      "outputs": [],
      "source": [
        "# função to generate a prompt using Exemplos from the context.\n",
        "def gen_mc_answer_lc_with_examples_prompt(num_examples): \n",
        "    examples_section = \"some example questions that refer to the government record above, along with correct answers.\"\n",
        "    para i in range(num_examples):\n",
        "        examples_section += \"\"\"\n",
        "<Question>\n",
        "{sample_question\"\"\" + str(i+1) + \"\"\"}\n",
        "</Question>\n",
        "<Answers>\n",
        "{sample_answers\"\"\" + str(i+1) + \"\"\"}\n",
        "</Answers>\n",
        "Here, the correct answer is:\n",
        "<Answer>\n",
        "{correct_answer\"\"\" + str(i+1) + \"\"\"}\n",
        "</Answer>\"\"\"\n",
        "    retornar \"\"\"\\n\\nHuman: Please ler the following government record closely and then answer the multiple choice question below.\n",
        "<Government Record>\n",
        "{chunk}\n",
        "</Government Record>\n",
        "First, here are \"\"\" + examples_section + \"\"\"\n",
        "Now here is the question para you to answer.\n",
        "<Question>\n",
        "{question}\n",
        "</Question>\n",
        "selecionar the correct answer to the question from the list below and escrever the corresponding letter (A, B, C, or D) in <Answer></Answer> tags.\n",
        "<Answers>\n",
        "{answers}\n",
        "</Answers>\n",
        "\n",
        "Assistant:\n",
        "\"\"\""
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 55,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Same as above, but includes scratchpad.\n",
        "def gen_mc_answer_lc_with_examples_prompt_scratchpad(num_examples): \n",
        "    examples_section = \"some example questions that refer to the government record above, along with correct answers.\"\n",
        "    para i in range(num_examples):\n",
        "        examples_section += \"\"\"\n",
        "<Question>\n",
        "{sample_question\"\"\" + str(i+1) + \"\"\"}\n",
        "</Question>\n",
        "<Answers>\n",
        "{sample_answers\"\"\" + str(i+1) + \"\"\"}\n",
        "</Answers>\n",
        "Here, the correct answer is:\n",
        "<Answer>\n",
        "{correct_answer\"\"\" + str(i+1) + \"\"\"}\n",
        "</Answer>\"\"\"\n",
        "    retornar \"\"\"\\n\\nHuman: Please ler the following government record closely and then answer the multiple choice question below.\n",
        "<Government Record>\n",
        "{chunk}\n",
        "</Government Record>\n",
        "First, here are \"\"\" + examples_section + \"\"\"\n",
        "Now here is the question para you to answer.\n",
        "<Question>\n",
        "{question}\n",
        "</Question>\n",
        "Pull 2-3 relevant quotes from the record that pertain to the question and escrever them inside <scratchpad></scratchpad> tags. Then, selecionar the correct answer to the question from the list below and escrever the corresponding letter (A, B, C, or D) in <Answer></Answer> tags.\n",
        "<Answers>\n",
        "{answers}\n",
        "</Answers>\n",
        "\n",
        "Assistant:\n",
        "\"\"\""
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 56,
      "metadata": {},
      "outputs": [],
      "source": [
        "# obter Exemplos randomly\n",
        "def grab_example_qas(long_context_row, long_context_col, qa_df, num_examples=2):\n",
        "    Exemplos = []\n",
        "    para i, row in qa_df.sample(frac=1).iterrows():  # Randomize order of questions\n",
        "        se row['chunk'] in long_context_row[long_context_col] and row['chunk'] != long_context_row.chunk:\n",
        "            # Exemplos must pertain to chunks that were included in the collage, but must not be the exact question in question.\n",
        "            Exemplos.anexar({\n",
        "                'question': row.question, 'answers': row.randomized_answers, \n",
        "                'correct_answer': [a para a in row.randomized_answers se row.right_answer in a][0][0]})\n",
        "        se len(Exemplos) >= num_examples:\n",
        "            parar\n",
        "    examples_numbered = {}\n",
        "    para i in range(num_examples):\n",
        "        examples_numbered['sample_question' + str(i+1)] = Exemplos[i]['question']\n",
        "        examples_numbered['sample_answers' + str(i+1)] = Exemplos[i]['answers']\n",
        "        examples_numbered['correct_answer' + str(i+1)] = Exemplos[i]['correct_answer']\n",
        "    retornar examples_numbered"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 57,
      "metadata": {},
      "outputs": [],
      "source": [
        "def format_for_long_ctx_with_examples(row, chunk_col, long_context_col, qa_df, num_examples=2):\n",
        "    # obter Exemplos QA pairs and plug them into the prompt\n",
        "    example_qas = grab_example_qas(long_context_row=row, long_context_col=long_context_col, qa_df=qa_df, num_examples=num_examples)\n",
        "    format_args = {}\n",
        "    para i in range(1, num_examples+1):\n",
        "        format_args['sample_question'+str(i)] = example_qas['sample_question'+str(i)] \n",
        "        format_args['sample_answers'+str(i)] = example_qas['sample_answers'+str(i)]\n",
        "        format_args['correct_answer'+str(i)] = example_qas['correct_answer'+str(i)]\n",
        "    retornar gen_mc_answer_lc_with_examples_prompt(num_examples).formatar(\n",
        "        chunk=row[chunk_col], question=row['question'], answers=row['randomized_answers'],\n",
        "        **format_args\n",
        "    )"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 58,
      "metadata": {},
      "outputs": [],
      "source": [
        "def format_for_long_ctx_with_examples_scratchpad(row, chunk_col, long_context_col, qa_df, num_examples=2):\n",
        "    # Same as above, but with scratchpad.\n",
        "    example_qas = grab_example_qas(long_context_row=row, long_context_col=long_context_col, qa_df=qa_df, num_examples=num_examples)\n",
        "    format_args = {}\n",
        "    para i in range(1, num_examples+1):\n",
        "        # The Exemplos are indexed from 1.\n",
        "        format_args['sample_question'+str(i)] = example_qas['sample_question'+str(i)] \n",
        "        format_args['sample_answers'+str(i)] = example_qas['sample_answers'+str(i)]\n",
        "        format_args['correct_answer'+str(i)] = example_qas['correct_answer'+str(i)]\n",
        "    retornar gen_mc_answer_lc_with_examples_prompt_scratchpad(num_examples).formatar(\n",
        "        chunk=row[chunk_col], question=row['question'], answers=row['randomized_answers'],\n",
        "        **format_args\n",
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "primeiro, we'll experiment com just 2 Exemplos."
      ]
