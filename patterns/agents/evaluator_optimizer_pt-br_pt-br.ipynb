        "## Evaluator-Optimizer fluxo de trabalho\nIn este fluxo de trabalho, one LLM call generates a resposta enquanto another provides evaluation e feedback in a loop.\n\n### quando para use este fluxo de trabalho\neste fluxo de trabalho is particularly effective quando we have:\n\n- limpar evaluation criteria\n- Value de iterative refinement\n\nThe two signs of good fit are:\n\n- LLM responses can be demonstrably improved quando feedback is provided\n- The LLM can provide meaningful feedback itself"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {},
      "outputs": [],
      "source": [
        "from util importar llm_call, extract_xml\n",
        "\n",
        "def generate(prompt: str, task: str, context: str = \"\") -> tuple[str, str]:\n",
        "    \"\"\"Generate and improve a solution based on feedback.\"\"\"\n",
        "    full_prompt = f\"{prompt}\\n{context}\\nTask: {task}\" se context senão f\"{prompt}\\nTask: {task}\"\n",
        "    response = llm_call(full_prompt)\n",
        "    thoughts = extract_xml(response, \"thoughts\")\n",
        "    result = extract_xml(response, \"response\")\n",
        "    \n",
        "    imprimir(\"\\n=== GENERATION START ===\")\n",
        "    imprimir(f\"Thoughts:\\n{thoughts}\\n\")\n",
        "    imprimir(f\"Generated:\\n{result}\")\n",
        "    imprimir(\"=== GENERATION END ===\\n\")\n",
        "    \n",
        "    retornar thoughts, result\n",
        "\n",
        "def evaluate(prompt: str, content: str, task: str) -> tuple[str, str]:\n",
        "    \"\"\"Evaluate se a solution meets Requisitos.\"\"\"\n",
        "    full_prompt = f\"{prompt}\\nOriginal task: {task}\\nContent to evaluate: {content}\"\n",
        "    response = llm_call(full_prompt)\n",
        "    evaluation = extract_xml(response, \"evaluation\")\n",
        "    feedback = extract_xml(response, \"feedback\")\n",
        "    \n",
        "    imprimir(\"=== EVALUATION START ===\")\n",
        "    imprimir(f\"Status: {evaluation}\")\n",
        "    imprimir(f\"Feedback: {feedback}\")\n",
        "    imprimir(\"=== EVALUATION END ===\\n\")\n",
        "    \n",
        "    retornar evaluation, feedback\n",
        "\n",
        "def loop(task: str, evaluator_prompt: str, generator_prompt: str) -> tuple[str, list[dict]]:\n",
        "    \"\"\"Keep generating and evaluating until Requisitos are met.\"\"\"\n",
        "    memory = []\n",
        "    chain_of_thought = []\n",
        "    \n",
        "    thoughts, result = generate(generator_prompt, task)\n",
        "    memory.anexar(result)\n",
        "    chain_of_thought.anexar({\"thoughts\": thoughts, \"result\": result})\n",
        "    \n",
        "    enquanto verdadeiro:\n",
        "        evaluation, feedback = evaluate(evaluator_prompt, result, task)\n",
        "        se evaluation == \"PASS\":\n",
        "            retornar result, chain_of_thought\n",
        "            \n",
        "        context = \"\\n\".juntar([\n",
        "            \"Previous attempts:\",\n",
        "            *[f\"- {m}\" para m in memory],\n",
        "            f\"\\nFeedback: {feedback}\"\n",
        "        ])\n",
        "        \n",
        "        thoughts, result = generate(generator_prompt, task, context)\n",
        "        memory.anexar(result)\n",
        "        chain_of_thought.anexar({\"thoughts\": thoughts, \"result\": result})"
      ]
    },
