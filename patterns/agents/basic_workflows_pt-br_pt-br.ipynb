        "    - Want clear direction\"\"\",\n",
        "    \n",
        "    \"\"\"Investors:\n",
        "    - esperar growth\n",
        "    - Want cost control\n",
        "    - Risk concerns\"\"\",\n",
        "    \n",
        "    \"\"\"Suppliers:\n",
        "    - Capacity constraints\n",
        "    - Price pressures\n",
        "    - Tech transitions\"\"\"\n",
        "]\n",
        "\n",
        "impact_results = parallel(\n",
        "    \"\"\"Analyze how market changes will impact this stakeholder group.\n",
        "    Provide specific impacts and recommended actions.\n",
        "    formatar with clear sections and priorities.\"\"\",\n",
        "    stakeholders\n",
        ")\n",
        "\n",
        "para result in impact_results:\n",
        "    imprimir(result)\n",
        "    imprimir('+' * 80)"
      ]
