      "source": [
        "## Basic Multi-LLM Workflows\n\neste notebook demonstrates three simples multi-LLM workflows. They trade off cost ou latency para potentially improved tarefa performances:\n\n1. **Prompt-Chaining**: Decomposes a tarefa into sequential subtasks, onde each step builds on anterior results\n2. **Parallelization**: Distributes independent subtasks across multiple LLMs para concurrent processing\n3. **Routing**: Dynamically selects specialized LLM paths based on entrada characteristics\n\nNota: estes are sample implementations meant para demonstrate core concepts - não produção code."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {},
      "outputs": [],
      "source": [
        "from concurrent.futures importar ThreadPoolExecutor\n",
        "from typing importar List, Dict, Callable\n",
        "from util importar llm_call, extract_xml"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": nulo,
      "metadata": {},
      "outputs": [],
      "source": [
        "def chain(entrada: str, prompts: List[str]) -> str:\n",
        "    \"\"\"Chain multiple LLM calls sequentially, passing results between steps.\"\"\"\n",
        "    result = entrada\n",
        "    para i, prompt in enumerate(prompts, 1):\n",
        "        imprimir(f\"\\nStep {i}:\")\n",
        "        result = llm_call(f\"{prompt}\\nInput: {result}\")\n",
        "        imprimir(result)\n",
        "    retornar result\n",
        "\n",
        "def parallel(prompt: str, inputs: List[str], n_workers: int = 3) -> List[str]:\n",
        "    \"\"\"Process multiple inputs concurrently with the same prompt.\"\"\"\n",
        "    with ThreadPoolExecutor(max_workers=n_workers) as executor:\n",
        "        futures = [executor.submit(llm_call, f\"{prompt}\\nInput: {x}\") para x in inputs]\n",
        "        retornar [f.result() para f in futures]\n",
        "\n",
        "def route(entrada: str, routes: Dict[str, str]) -> str:\n",
        "    \"\"\"Route entrada to specialized prompt using content classification.\"\"\"\n",
        "    # First determine appropriate route using LLM with chain-of-thought\n",
        "    imprimir(f\"\\nAvailable routes: {list(routes.keys())}\")\n",
        "    selector_prompt = f\"\"\"\n",
        "    Analyze the entrada and selecionar the most appropriate support team from these Opções: {list(routes.keys())}\n",
        "    First explain your reasoning, then provide your selection in this XML formatar:\n",
        "\n",
        "    <reasoning>\n",
        "    Brief explanation of why this ticket should be routed to a specific team.\n",
        "    Consider key terms, user intent, and urgency level.\n",
        "    </reasoning>\n",
        "\n",
        "    <selection>\n",
        "    The chosen team nome\n",
        "    </selection>\n",
        "\n",
        "    entrada: {entrada}\"\"\".limpar()\n",
        "    \n",
        "    route_response = llm_call(selector_prompt)\n",
        "    reasoning = extract_xml(route_response, 'reasoning')\n",
        "    route_key = extract_xml(route_response, 'selection').limpar().lower()\n",
        "    \n",
        "    imprimir(\"Routing Analysis:\")\n",
        "    imprimir(reasoning)\n",
        "    imprimir(f\"\\nSelected route: {route_key}\")\n",
        "    \n",
        "    # Process entrada with selected specialized prompt\n",
        "    selected_prompt = routes[route_key]\n",
        "    retornar llm_call(f\"{selected_prompt}\\nInput: {entrada}\")"
      ]
    },
