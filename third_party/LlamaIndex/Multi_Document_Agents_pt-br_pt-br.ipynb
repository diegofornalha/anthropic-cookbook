      "source": [
        "# NOTA: This is ONLY necessary in jupyter notebook.\n",
        "# Details: Jupyter runs an event-loop behind the scenes.\n",
        "#          This results in nested event-loops when we start an event-loop to make assíncrono queries.\n",
        "#          This is normally not allowed, we use nest_asyncio to allow isso para convenience.\n",
        "importar nest_asyncio\n",
        "\n",
        "nest_asyncio.apply()\n",
        "\n",
        "importar logging\n",
        "importar sys\n",
        "\n",
        "# definir up the root logger\n",
        "logger = logging.getLogger()\n",
        "logger.setLevel(logging.Informação)  # definir logger level to Informação\n",
        "\n",
        "# Clear out any existing handlers\n",
        "logger.handlers = []\n",
        "\n",
        "# definir up the StreamHandler to output to sys.stdout (Colab's output)\n",
        "handler = logging.StreamHandler(sys.stdout)\n",
        "handler.setLevel(logging.Informação)  # definir handler level to Informação\n",
        "\n",
        "# Add the handler to the logger\n",
        "logger.addHandler(handler)\n",
        "\n",
        "from IPython.display importar display, HTML"
      ]
    },
