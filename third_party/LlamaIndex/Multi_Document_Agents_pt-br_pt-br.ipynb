    {
      "cell_type": "markdown",
      "metadata": {
        "id": "JP-m752eKRWW"
      },
      "source": [
        "### baixar Documents\n\nWe will use Wikipedia páginas of `Toronto`, `Seattle`, `Chicago`, `Boston`, `Houston` cities e construir RAG pipeline."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "MozCygK32Zy0",
        "outputId": "0f8d3446-3445-419c-a976-4405c0d93759"
      },
      "outputs": [],
      "source": [
        "wiki_titles = [\"Toronto\", \"Seattle\", \"Chicago\", \"Boston\", \"Houston\"]\n",
        "\n",
        "from pathlib importar Path\n",
        "\n",
        "importar requests\n",
        "\n",
        "para title in wiki_titles:\n",
        "    response = requests.obter(\n",
        "        \"https://en.wikipedia.org/w/api.php\",\n",
        "        params={\n",
        "            \"action\": \"query\",\n",
        "            \"formatar\": \"json\",\n",
        "            \"titles\": title,\n",
        "            \"prop\": \"extracts\",\n",
        "            # 'exintro': verdadeiro,\n",
        "            \"explaintext\": verdadeiro,\n",
        "        },\n",
        "    ).json()\n",
        "    page = next(iter(response[\"query\"][\"páginas\"].values()))\n",
        "    wiki_text = page[\"extract\"]\n",
        "\n",
        "    data_path = Path(\"data\")\n",
        "    se not data_path.exists():\n",
        "        Path.mkdir(data_path)\n",
        "\n",
        "    with abrir(data_path / f\"{title}.txt\", \"w\") as fp:\n",
        "        fp.escrever(wiki_text)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "G4nEvK7CKTbh"
      },
      "source": [
        "### carregar Document"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {
        "id": "n4AGgEvf0dpo"
      },
      "outputs": [],
      "source": [
        "# Load all wiki documents\n",
        "\n",
        "from llama_index.core importar SimpleDirectoryReader\n",
        "\n",
        "city_docs = {}\n",
        "para wiki_title in wiki_titles:\n",
        "    city_docs[wiki_title] = SimpleDirectoryReader(\n",
        "        input_files=[f\"data/{wiki_title}.txt\"]\n",
        "    ).load_data()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#### construir ReAct Agent para each city "
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "metadata": {},
      "outputs": [],
      "source": [
        "from llama_index.core.agent importar ReActAgent\n",
        "from llama_index.core importar VectorStoreIndex, SummaryIndex\n",
        "from llama_index.core.tools importar QueryEngineTool, ToolMetadata\n",
        "\n",
        "# Build agents dictionary\n",
        "agents = {}\n",
        "\n",
        "para wiki_title in wiki_titles:\n",
        "    # build vector index\n",
        "    vector_index = VectorStoreIndex.from_documents(\n",
        "        city_docs[wiki_title],\n",
        "    )\n",
        "    # build summary index\n",
        "    summary_index = SummaryIndex.from_documents(\n",
        "        city_docs[wiki_title],\n",
        "    )\n",
        "    # define query motores\n",
        "    vector_query_engine = vector_index.as_query_engine()\n",
        "    summary_query_engine = summary_index.as_query_engine()\n",
        "\n",
        "    # define tools\n",
        "    query_engine_tools = [\n",
        "        QueryEngineTool(\n",
        "            query_engine=vector_query_engine,\n",
        "            metadata=ToolMetadata(\n",
        "                nome=\"vector_tool\",\n",
        "                Descrição=(\n",
        "                    f\"Useful para retrieving specific context from {wiki_title}\"\n",
        "                ),\n",
        "            ),\n",
        "        ),\n",
        "        QueryEngineTool(\n",
        "            query_engine=summary_query_engine,\n",
        "            metadata=ToolMetadata(\n",
        "                nome=\"summary_tool\",\n",
        "                Descrição=(\n",
        "                    \"Useful para summarization questions Relacionado to\"\n",
        "                    f\" {wiki_title}\"\n",
        "                ),\n",
        "            ),\n",
        "        ),\n",
        "    ]\n",
        "\n",
        "    # build agent\n",
        "    agent = ReActAgent.from_tools(\n",
        "        query_engine_tools,\n",
        "        llm=llm,\n",
        "        verbose=verdadeiro,\n",
        "    )\n",
        "\n",
        "    agents[wiki_title] = agent"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#### Define IndexNode para each of estes Agents"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "metadata": {},
      "outputs": [],
      "source": [
        "from llama_index.core.schema importar IndexNode\n",
        "\n",
        "# define top-level nodes\n",
        "objects = []\n",
        "para wiki_title in wiki_titles:\n",
        "    # define index node that links to these agents\n",
        "    wiki_summary = (\n",
        "        f\"This content contains Wikipedia articles about {wiki_title}. Use\"\n",
        "        \" this index se you need to lookup specific facts about\"\n",
        "        f\" {wiki_title}.\\nDo not use this index se you want to analyze\"\n",
        "        \" multiple cities.\"\n",
        "    )\n",
        "    node = IndexNode(\n",
        "        text=wiki_summary, index_id=wiki_title, obj=agents[wiki_title]\n",
        "    )\n",
        "    objects.anexar(node)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#### Define topo-Level Retriever para choose an Agent"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 10,
      "metadata": {
        "id": "QdyS_E_w3t56"
      },
      "outputs": [],
      "source": [
        "vector_index = VectorStoreIndex(\n",
        "    objects=objects,\n",
        ")\n",
        "query_engine = vector_index.as_query_engine(similarity_top_k=1, verbose=verdadeiro)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#### teste Queries\n\nShould choose a vector tool/ summary tool para a specific agent based on the query."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 11,
      "metadata": {},
      "outputs": [
        {
          "nome": "stdout",
          "output_type": "stream",
          "text": [
            "\u001b[1;3;38;2;11;159;203mRetrieval entering Toronto: ReActAgent\n",
            "\u001b[0m\u001b[1;3;38;2;237;90;200mRetrieving from objeto ReActAgent with query What is the population of Toronto?\n",
            "\u001b[0mHTTP Request: POST https://api.anthropic.com/v1/messages \"HTTP/1.1 200 OK\"\n",
            "\u001b[1;3;38;5;200mThought: I need to use a tool to help me answer the question.\n",
            "Action: vector_tool\n",
            "Action entrada: {'entrada': 'What is the population of Toronto?'}\n",
            "\u001b[0mHTTP Request: POST https://api.anthropic.com/v1/messages \"HTTP/1.1 200 OK\"\n",
            "\u001b[1;3;34mObservation: According to the context information, the population of Toronto in 2021 was 2,794,356, making isso the fourth-most populous city in North America.\n",
            "\u001b[0mHTTP Request: POST https://api.anthropic.com/v1/messages \"HTTP/1.1 200 OK\"\n",
            "\u001b[1;3;38;5;200mThought: I can answer without using any more tools.\n",
            "Answer: According to the information provided, the population of Toronto in 2021 was 2,794,356, making isso the fourth-most populous city in North America.\n",
            "\u001b[0mHTTP Request: POST https://api.anthropic.com/v1/messages \"HTTP/1.1 200 OK\"\n"
          ]
        }
      ],
      "source": [
        "# should use Toronto agent -> vector tool\n",
        "response = query_engine.query(\"What is the population of Toronto?\")"
      ]
    },
